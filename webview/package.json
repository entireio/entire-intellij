{
  "name": "entire-intellij-webview",
  "version": "0.1.0",
  "private": true,
  "description": "The panel pages that Entire for JetBrains IDEs shows in its embedded browser.",
  "license": "MIT",
  "scripts": {
    "build": "node esbuild.mjs",
    "bundle": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "markdown-it": "^15.0.3",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
